<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
        "http://struts.apache.org/dtds/struts-config_1_3.dtd">
<struts-config>
    <form-beans>
        <form-bean name="loginForm" type="com.zavabank.paygateway.LoginForm"/>
        <form-bean name="paymentForm" type="com.zavabank.paygateway.PaymentForm"/>
    </form-beans>

    <action-mappings>
        <action path="/login"
                type="com.zavabank.paygateway.LoginAction"
                name="loginForm"
                scope="request"
                validate="false"
                input="/WEB-INF/jsp/login.jsp">
            <forward name="login" path="/WEB-INF/jsp/login.jsp"/>
            <forward name="success" path="/makePayment.do" redirect="true"/>
        </action>

        <action path="/makePayment"
                type="com.zavabank.paygateway.PaymentAction"
                name="paymentForm"
                scope="request"
                validate="false"
                input="/WEB-INF/jsp/payment.jsp">
            <forward name="success" path="/WEB-INF/jsp/payment.jsp"/>
            <forward name="login" path="/login.do" redirect="true"/>
            <forward name="history" path="/paymentHistory.do" redirect="true"/>
        </action>

        <action path="/paymentHistory"
                type="com.zavabank.paygateway.PaymentHistoryAction">
            <forward name="success" path="/WEB-INF/jsp/payment-history.jsp"/>
            <forward name="login" path="/login.do" redirect="true"/>
        </action>

        <action path="/health"
                type="com.zavabank.paygateway.HealthAction">
            <forward name="success" path="/health.jsp"/>
        </action>
    </action-mappings>
</struts-config>
